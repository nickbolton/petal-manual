{
  "include": [
    "app/**/*",
    "*.ts",
    ".react-router/types/**/*"
  ],
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2023"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "rootDirs": [
      ".",
      ".react-router/types"
    ]
  }
}
