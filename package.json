{
  "name": "petal-user-manual",
  "version": "1.0.0",
  "private": true,
  "description": "A searchable, illustrated field guide to the Petal iOS app.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "build": "react-router build",
    "start": "node server.mjs",
    "check": "react-router typegen && tsc --noEmit && node --check server.mjs",
    "test": "tsx --test test/*.test.*",
    "heroku-postbuild": "npm run build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "tsx": "^4.0.0",
    "jsdom": "^29.0.0",
    "@types/jsdom": "^28.0.0"
  }
}
